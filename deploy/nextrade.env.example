# Copy to /etc/nextrade.env, fill in, then `chmod 600` it.
#
# The app refuses to boot in production on any of these being wrong, rather
# than starting and failing quietly later. That is deliberate — see
# app/config.py.

# openssl rand -hex 32
# Under 32 characters and the app will not start: the signature becomes the
# weak link. The example value in the repository is public.
JWT_SECRET=

# ABSOLUTE path. A relative SQLite path is refused, because on a container that
# is ephemeral storage and the first redeploy silently deletes every account.
DATABASE_URL=sqlite:////opt/nextrade/data/nextrade.db

# The 179 MB NAV store, on the block volume rather than the boot disk.
NEXTRADE_NAV_DB=/opt/nextrade/data/navstore/nav.db

# Disk caches. Losing these costs one slow request each, nothing more.
NEXTRADE_CACHE_DIR=/opt/nextrade/data/.navcache
NEXTRADE_STOCK_CACHE_DIR=/opt/nextrade/data/.stockcache

# Your exact frontend origin. No wildcard — this API sends credentials, so `*`
# lets any site read a logged-in portfolio, and browsers reject the
# combination anyway, which shows up as a total CORS outage rather than a
# clear error.
ALLOWED_ORIGINS=https://nextrade.vercel.app

BACKEND_URL=https://api.example.com

# One instance only. If you ever run more than one, exactly one gets this, or
# every copy runs the nightly job against the same store.
SCREENER_JOB_ENABLED=1

ENVIRONMENT=production
