# --- secrets (NEVER commit real keys) ---
.env
backend/.env
frontend/.env
*.key
*.pem

# --- python ---
__pycache__/
*.py[cod]
venv/
.venv/
env/
*.db
*.sqlite3
.pytest_cache/
.mypy_cache/
backend/*.egg-info/

# --- node / frontend ---
node_modules/
dist/
build/
.vite/
*.local

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.navcache
# The NAV spine: ~184 MB of public, rederivable data. Never committed.
.navstore/
# Raw Groww payloads. Never committed, and for a stronger reason than size:
# they come from an endpoint groww.in marks `Disallow` in robots.txt, so
# redistributing them in a repo is a different act from fetching them for
# personal research. 6.1 MB today and one `git add -A` from being public.
backend/.growwcache/
.growwcache/
# Harness screenshots: regenerated by scripts/shots.mjs, ~29 MB a run.
frontend/shots//
.stockcache/
.newscache/
.holdingscache/
# The look-through store. NOT a cache, despite sitting next to three of them:
# Groww serves only the CURRENT month's disclosure, so a deleted July 2026
# portfolio is gone permanently and no script can rebuild it. Gitignored because
# it is a growing binary SQLite file -- and because it is gitignored, git is not
# its backup. A gzipped `.dump` is committed monthly instead; see the plan's
# section 16.4. Ignoring this without that dump means the irrecoverable store
# has no backup at all.
.holdings/

# Local agent config — contains API keys, never commit
.mcp.json
.claude
backend/.parity-venv/

# Scratch dir created by browser automation tooling.
.playwright-mcp/

# Harness screenshot output and MCP tool logs — generated, not source.
frontend/shots/
logs/
